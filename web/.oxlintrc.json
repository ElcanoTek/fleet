{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "jsx-a11y",
    "import"
  ],
  "categories": {
    "correctness": "error",
    "perf": "off",
    "suspicious": "off",
    "pedantic": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  // Every rule below is "error". There are deliberately NO "warn" entries: a
  // warn severity here was a burn-down list (adopting TS 7 was not going to
  // become "fix every a11y issue in one PR"), and the burn-down is finished —
  // all 55 findings were fixed, not silenced. `npm run lint` passes
  // --deny-warnings so a rule re-introduced at warn fails the build instead of
  // quietly re-opening the backlog.
  "rules": {
    // The automatic JSX runtime injects React; the classic in-scope requirement does not apply.
    "react/react-in-jsx-scope": "off",
    "react/exhaustive-deps": "error",
    "react/hooks": "error",
    "typescript/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_",
        "destructuredArrayIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "jsx-a11y/prefer-tag-over-role": "off",

    // Promoted from warn once the findings were fixed. These are the a11y
    // guarantees the app now holds: a click handler has a keyboard path, an
    // element carrying behavior says what it is, every control has a name,
    // focus is moved by an effect tied to a user action rather than by
    // autoFocus firing on any mount, and internal navigation goes through the
    // client router instead of reloading the document.
    "jsx-a11y/click-events-have-key-events": "error",
    "jsx-a11y/no-static-element-interactions": "error",
    "jsx-a11y/no-noninteractive-element-interactions": "error",
    "jsx-a11y/no-autofocus": "error",
    "jsx-a11y/label-has-associated-control": "error",
    "jsx-a11y/control-has-associated-label": "error",
    "jsx-a11y/no-redundant-roles": "error",
    "jsx-a11y/no-noninteractive-tabindex": "error",
    "react/immutability": "error",
    "eslint/no-control-regex": "error"
  },
  "ignorePatterns": [
    "node_modules/**",
    ".next/**",
    "out/**",
    "build/**",
    "test-results/**",
    "next-env.d.ts"
  ]
}
