# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env
.env.local

# Operator lifecycle runtime artifacts (scripts/bootstrap.sh + scripts/update.sh)
.fleet-state/
.fleet-client/
.fleet/tool-output/

# `fleet task run` one-shot run workspaces + logs (scripts/run_workflow_live.sh)
.fleet-runs/

# Editor/IDE
# .idea/
# .vscode/

# Python (fleet MCP servers)
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
/internal/tools/data/
/internal/agent/data/

# Node / Next.js (fleet web)
node_modules/
# ...and as a plain path, so the SYMLINK form is ignored too. Developing in a
# `git worktree` means a fresh tree has no web/node_modules until `npm ci`, and
# the usual shortcut is to symlink it at the main checkout's copy. The trailing
# slash above matches only a directory, so that symlink is a tracked-able file
# — it reached `dev` once and broke the CodeQL run, which cannot stat a link
# pointing outside the workspace.
web/node_modules
.next/
*.tsbuildinfo
web/test-results/
web/playwright-report/

# Live e2e runtime artifacts (scripts/e2e-boot-server.sh)
.e2e-bin/
.e2e-run/
web/.e2e-live.env
# Stray local fleet runtime files
/fake-llm
/fleet
/fleet-admin
/fleet-bench
# `make helm-package` output — a stamped chart tarball, built on demand and
# never committed (the chart is installed from the checkout; ADR-0059).
/fleet-*.tgz
fleet-session.json
*.pid
/workspace/

# Server runtime data directory (attachments, audit logs, task-run workspaces)
/data/

# Per-run bash audit logs the agent loop writes to CWD during tests.
internal/acpruntime/data/
internal/acpingress/data/

# middle-manager state directory
.middle-manager/

# Agent-harness scratch: `git worktree` checkouts an AI coding agent creates for
# isolated parallel work. Each entry is a full working tree, so committing them
# would land the repo inside itself. Only the worktrees dir is ignored — the rest
# of `.claude/` (skills, settings) stays tracked.
.claude/worktrees/
