# deploy/fleet-web.service — systemd unit for the public Next.js web tier.
#
# The browser only ever talks to this Next app; the app proxies server-side over
# loopback to the two Go backends the `fleet` process boots (chat :8080,
# orchestrator :8000). Caddy (deploy/Caddyfile) fronts THIS unit with TLS. The
# Go backends stay loopback-only — they are NOT exposed.
#
#   browser ──TLS──▶ Caddy ──▶ fleet-web (:3000) ──▶ fleet: chat :8080 + orchestrator :8000
#
# This unit is the supervised counterpart to fleet.service (it replaces the
# hand-run `cd web && npm run start` the README used to leave to the operator —
# the same regression chat-web.service covered in the chat repo). Run BOTH units.
#
# Install (after `make build` + `cd web && npm ci && npm run build`):
#   useradd --system --home-dir /var/lib/fleet-web --shell /usr/sbin/nologin \
#     --no-create-home fleet-web              # the unit's unprivileged user (see below)
#   install -d /opt/fleet/web
#   cp -a web/. /opt/fleet/web/          # the built Next app (incl. .next/ + node_modules or run npm ci on the box)
#   chown -R fleet-web:fleet-web /opt/fleet/web/.next   # the only path next writes at runtime
#   install -D -m 0644 deploy/fleet-web.service /etc/systemd/system/fleet-web.service
#   install -D -m 0600 /dev/null /etc/fleet/fleet-web.env   # then fill it in (see below)
#   systemctl daemon-reload && systemctl enable --now fleet-web
#
# Minimum keys in /etc/fleet/fleet-web.env (0600) — scripts/bootstrap.sh's
# deploy_web_tier writes exactly this set:
#   CHAT_SERVER_URL=http://127.0.0.1:8080         # the fleet chat backend (loopback)
#   ORCHESTRATOR_SERVER_URL=http://127.0.0.1:8000 # the fleet orchestrator backend (loopback)
#   CHAT_SERVER_TOKEN=...                          # MUST match the binary's FLEET_SERVER_TOKEN
#   ORCHESTRATOR_SERVER_TOKEN=...                  # orchestrator API key (bootstrap mirrors ADMIN_API_KEY)
#   APP_SESSION_SECRET=...                         # signs the web session cookie (rotating logs everyone out)
#   PORT=3000                                      # the port `next start` binds (Caddy proxies to it)
#   NODE_ENV=production
#   # plus whatever auth env the web app needs (e.g. the elcano_auth public key).
#
# Optional:
#   FLEET_WEB_HOST=0.0.0.0    # the address `next start` binds. Defaults to
#                             # 127.0.0.1 (web/package.json's start script):
#                             # only Caddy on this box should reach :3000,
#                             # because the web tier trusts x-forwarded-* from
#                             # its proxy. Widen ONLY when TLS terminates on
#                             # another host.

[Unit]
Description=fleet web tier (Next.js app — public origin, proxies to loopback backends)
Documentation=https://github.com/ElcanoTek/fleet
After=network-online.target fleet.service
Wants=network-online.target
# The web app is useless without the backends; keep it bound to fleet.service.
BindsTo=fleet.service

[Service]
Type=simple
WorkingDirectory=/opt/fleet/web
EnvironmentFile=/etc/fleet/fleet-web.env
# `npm run start` → `next start -H ${FLEET_WEB_HOST:-127.0.0.1}` — loopback by
# default, so the topology diagram above is enforced, not just documented
# (`next start` alone binds 0.0.0.0 and would expose :3000 past Caddy). Use an
# absolute npm if PATH under the unit is minimal (e.g. ExecStart=/usr/bin/npm
# run start).
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=30s

# ── Service identity ──
# This is the ONLY public-facing process, so it runs as a dedicated
# unprivileged fixed system user — never root. Unlike fleet.service it drives
# no rootless Podman, so it needs no subuid ranges; a plain nologin system
# user is enough (bootstrap creates it; the header shows the manual useradd).
# StateDirectory provides a writable HOME (/var/lib/fleet-web) for npm's
# cache/config, which ProtectHome would otherwise mask.
User=fleet-web
Group=fleet-web
StateDirectory=fleet-web
StateDirectoryMode=0700
Environment=HOME=/var/lib/fleet-web

# Hardening — the web tier only needs to bind its port and reach the loopback
# backends. It writes nothing outside .next/ (Next's runtime cache; chown it
# to fleet-web when deploying, as bootstrap/update do).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/fleet/web/.next

[Install]
WantedBy=multi-user.target
