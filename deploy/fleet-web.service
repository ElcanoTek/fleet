# deploy/fleet-web.service — systemd unit for the public Next.js web tier.
#
# The browser only ever talks to this Next app; the app proxies server-side over
# loopback to the two Go backends the `fleet` process boots (chat :8080,
# orchestrator :8000). Caddy (deploy/Caddyfile) fronts THIS unit with TLS. The
# Go backends stay loopback-only — they are NOT exposed.
#
#   browser ──TLS──▶ Caddy ──▶ fleet-web (:3000) ──▶ fleet: chat :8080 + orchestrator :8000
#
# This unit is the supervised counterpart to fleet.service (it replaces the
# hand-run `cd web && npm run start` the README used to leave to the operator —
# the same regression chat-web.service covered in the chat repo). Run BOTH units.
#
# Install (after `make build` + `cd web && npm ci && npm run build`):
#   useradd --system --home-dir /var/lib/fleet-web --shell /usr/sbin/nologin \
#     --no-create-home fleet-web              # the unit's unprivileged user (see below)
#   install -d /opt/fleet/web
#   cp -a web/. /opt/fleet/web/          # the built Next app (incl. .next/ + node_modules or run npm ci on the box)
#                                        # node_modules is REQUIRED: ExecStart runs
#                                        # node_modules/next/dist/bin/next directly.
#   chown -R fleet-web:fleet-web /opt/fleet/web/.next   # the only path next writes at runtime
#   install -D -m 0755 deploy/fleet-web-start.sh /usr/local/bin/fleet-web-start.sh
#                                        # ^ ExecStart; resolves the node interpreter
#   install -D -m 0644 deploy/fleet-web.service /etc/systemd/system/fleet-web.service
#   install -D -m 0644 deploy/fleet-web.service.d/10-timeout-kill.conf \
#     /etc/systemd/system/fleet-web.service.d/10-timeout-kill.conf
#                                        # ^ REQUIRED on Fedora and any distro
#                                        # shipping a global service.d drop-in
#                                        # (see TimeoutStopFailureMode below).
#   install -D -m 0600 /dev/null /etc/fleet/fleet-web.env   # then fill it in (see below)
#   systemctl daemon-reload && systemctl enable --now fleet-web
#
# Minimum keys in /etc/fleet/fleet-web.env (0600) — scripts/bootstrap.sh's
# deploy_web_tier writes exactly this set:
#   CHAT_SERVER_URL=http://127.0.0.1:8080         # the fleet chat backend (loopback)
#   ORCHESTRATOR_SERVER_URL=http://127.0.0.1:8000 # the fleet orchestrator backend (loopback)
#   CHAT_SERVER_TOKEN=...                          # MUST match the binary's FLEET_SERVER_TOKEN
#   ORCHESTRATOR_SERVER_TOKEN=...                  # orchestrator API key (bootstrap mirrors ADMIN_API_KEY)
#   APP_SESSION_SECRET=...                         # signs the web session cookie (rotating logs everyone out)
#   PORT=3000                                      # the port `next start` binds (Caddy proxies to it)
#   NODE_ENV=production
#   FLEET_NODE_BIN=/usr/bin/node-24                # the node to run (bootstrap/doctor
#                                                  # write this; see fleet-web-start.sh).
#                                                  # Unset falls back to `node` on PATH.
#   # plus whatever auth env the web app needs (e.g. the elcano_auth public key).
#
# Optional:
#   FLEET_WEB_HOST=0.0.0.0    # the address `next start` binds. Defaults to
#                             # 127.0.0.1 (the Environment= line in [Service]):
#                             # only Caddy on this box should reach :3000,
#                             # because the web tier trusts x-forwarded-* from
#                             # its proxy. Widen ONLY when TLS terminates on
#                             # another host.
#
# Shutdown note: this unit stops the web tier with SIGTERM, allows
# TimeoutStopSec=30s, then escalates with SIGKILL — never SIGABRT. See the
# TimeoutStopFailureMode comment below and docs/WEB-TIER-SHUTDOWN.md.

[Unit]
Description=fleet web tier (Next.js app — public origin, proxies to loopback backends)
Documentation=https://github.com/ElcanoTek/fleet
After=network-online.target fleet.service
Wants=network-online.target
# The web app is useless without the backends; keep it bound to fleet.service.
BindsTo=fleet.service

[Service]
Type=simple
WorkingDirectory=/opt/fleet/web
# Default the bind address BEFORE the env file is read, so /etc/fleet/fleet-web.env
# can still override it (EnvironmentFile wins over an earlier Environment=).
# This replaces the `${FLEET_WEB_HOST:-127.0.0.1}` shell default that lived in
# web/package.json's start script, which is no longer on the path now that
# ExecStart runs next directly.
Environment=FLEET_WEB_HOST=127.0.0.1
EnvironmentFile=/etc/fleet/fleet-web.env
# There is NO `npm run start` wrapper here, and there must not be. npm's crash
# on every single stop was the original bug: with npm in the middle,
# `systemctl stop` SIGTERMs the whole control group, npm's child exits first,
# and npm then forwards the signal to a process it has already reaped —
# segfaulting inside uv_kill → node::Kill → ProcessWrap::OnExit, writing a core
# dump per restart for a process whose only remaining job was to exit.
#
# What ExecStart points at instead is a shim that `exec`s, which is a different
# thing entirely: after the exec the shell is REPLACED by node, so the cgroup
# holds exactly one process (verified: same pid, `next-server`) and SIGTERM
# reaches node with nothing left to relay it. A supervisor that lingers is the
# hazard; a shim that becomes the program is not.
#
# It exists because the interpreter cannot be named statically. Fedora's node
# packages are parallel-installable: nodejs24 provides /usr/bin/node-24 while
# /usr/bin/node stays on whatever stream the release designated default, so a
# hardcoded /usr/bin/node would silently keep serving the old major. systemd
# cannot paper over that either — it does not expand a variable used as the
# executable (`ExecStart=${FLEET_NODE_BIN} …` is taken as a literal path;
# verified with systemd-analyze), so the resolution has to happen inside a
# fixed program. bootstrap/doctor write FLEET_NODE_BIN into the env file; the
# shim honours it and falls back to `node` on PATH. See
# deploy/fleet-web-start.sh and docs/WEB-TIER-SHUTDOWN.md.
#
# The shim also applies -H (loopback-only, so the topology diagram above is
# enforced and not merely documented — `next start` with no -H binds 0.0.0.0
# and would expose :3000 past Caddy) and leaves PORT to `next start`, exactly
# as before.
ExecStart=/usr/local/bin/fleet-web-start.sh
Restart=always
RestartSec=5s
KillSignal=SIGTERM
# 30s sits inside the 10-30s window the Next.js self-hosting guide asks
# platforms to allow for a graceful stop. In practice this server exits in
# well under a second — measured at ~105ms even with an open-ended SSE
# response in flight (docs/WEB-TIER-SHUTDOWN.md) — so the budget is headroom,
# not an expected wait.
TimeoutStopSec=30s
# If a stop DOES overrun that budget, escalate with SIGKILL, not SIGABRT. This is not cosmetic: Fedora ships a systemd-system.conf drop-in
# setting TimeoutStopFailureMode=abort, so a web tier that overran the drain
# was SIGABRT'd and dumped ~130 MB of core every time. A stop that overran its
# deadline is a hang to fix, not a crash to dissect — SIGKILL reports the same
# timeout in the journal and writes no dump. (systemd >= 246; older systemd
# logs an unknown-key warning and keeps its default.)
#
# PRECEDENCE CAVEAT: Fedora's drop-in lives in the GLOBAL
# /usr/lib/systemd/system/service.d/ directory, and drop-ins are read AFTER
# the unit body — so the distro's `abort` beats the line below no matter what
# this file says (verified on Fedora 44: `systemctl show` reported `abort`
# with this line present). The per-unit drop-in
# deploy/fleet-web.service.d/10-timeout-kill.conf restates `kill` at the
# precedence level that actually wins; install both. The line below stays as
# the correct value for distros without the global drop-in.
TimeoutStopFailureMode=kill
# Next handles SIGTERM and exits with code 143 (128+SIGTERM) rather than being
# killed by the signal outright. systemd's default clean set only covers a
# process KILLED by SIGTERM, so Next's exit(143) was logged as a failed stop
# ("Failed with result 'exit-code'") on every otherwise-clean shutdown.
# Declaring 143 names Next's clean-stop code; it does not paper over crashes —
# SIGSEGV/SIGABRT exits still fail and are still logged, and LimitCORE=0 (below)
# still applies to them.
SuccessExitStatus=143

# ── Service identity ──
# This is the ONLY public-facing process, so it runs as a dedicated
# unprivileged fixed system user — never root. Unlike fleet.service it drives
# no rootless Podman, so it needs no subuid ranges; a plain nologin system
# user is enough (bootstrap creates it; the header shows the manual useradd).
# StateDirectory provides a writable HOME (/var/lib/fleet-web), which
# ProtectHome would otherwise mask. npm no longer runs under this unit, but
# node and next still expect a writable HOME for their config/telemetry
# directory, and a read-only HOME surfaces as startup noise.
User=fleet-web
Group=fleet-web
StateDirectory=fleet-web
StateDirectoryMode=0700
Environment=HOME=/var/lib/fleet-web

# Hardening — the web tier only needs to bind its port and reach the loopback
# backends. It writes nothing outside .next/ (Next's runtime cache; chown it
# to fleet-web when deploying, as bootstrap/update do).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/fleet/web/.next

# ── No core dumps ──
# Two independent reasons, and the security one
# is the reason it is not merely disk hygiene:
#
#  1. A core dump is a full memory image, and this process holds the
#     deployment's shared secrets — CHAT_SERVER_TOKEN, ORCHESTRATOR_SERVER_TOKEN,
#     APP_SESSION_SECRET — plus every in-flight user's session and request body.
#     Writing that to /var/lib/systemd/coredump on every crash persists exactly
#     what fleet's credential invariant says must never reach logs or disk.
#  2. next-server currently segfaults during V8/libuv TEARDOWN on some node
#     builds (see docs/WEB-TIER-SHUTDOWN.md) — after it has stopped serving, so
#     the dump describes an exit path, not a serving fault. Each one cost
#     ~130 MB; days of deploys had filled the coredump directory.
#
# This does NOT hide the crash: systemd still logs the signal and the unit
# still records the failed stop, so `systemctl status` / journalctl show it.
# It only declines to keep the memory image. To collect one deliberately while
# debugging, drop it in for one boot and remove it after:
#   systemctl edit fleet-web   →   [Service] / LimitCORE=infinity
LimitCORE=0

[Install]
WantedBy=multi-user.target
