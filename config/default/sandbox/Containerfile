# Fedora-based container image bundling the Python data-analysis stack
# (pandas, numpy, scipy, matplotlib, seaborn, scikit-learn, pyarrow,
# ipykernel), document/image tooling (Pillow, openpyxl, xlsxwriter,
# pypdf, reportlab, BeautifulSoup, lxml, pyyaml, tabulate), and a
# handful of read-only CLI tools (git, jq, ripgrep, pandoc,
# ImageMagick, etc.). Designed to be run as a rootless one-shot
# container under hardened defaults:
#
#     podman run --rm \
#       --read-only \
#       --cap-drop=ALL \
#       --security-opt=no-new-privileges \
#       --network=none \
#       --tmpfs=/tmp:rw,size=128m \
#       --tmpfs=/home/sandbox/.ipython:rw,size=32m \
#       --tmpfs=/home/sandbox/.cache:rw,size=32m \
#       --storage-opt=size=5g \           # writable-layer disk quota (#216);
#                                         # falls back to --ulimit=fsize=5368709120
#                                         # on drivers without project-quota support
#       --volume=/path/to/workspace:/workspace:rw,Z \
#       localhost/fleet-sandbox:latest
#
# /opt/bridge is a pre-created mount point for callers who want to
# bind-mount an extra script into the container without touching the
# rest of the rootfs. Empty by default.
#
# Network-shaped tools (curl, wget) are intentionally absent — the image
# is intended for --network=none use, and shipping them would only
# mislead callers.
#
# This Containerfile ships in the GENERIC default client bundle
# (config/default/sandbox/). The sandbox image is a per-client CONFIG-BUNDLE
# artifact: each client's XYZ-config repo ships its own
# sandbox/Containerfile flavor and is free to add/remove packages and to pin
# its own base digest. This generic flavor is what fleet builds on-box when a
# deployment uses the default bundle (or any bundle that doesn't override it).
#
# Base tracks fedora-minimal:latest, so every on-box rebuild picks up the current
# upstream security patches with no manual digest bumps — the right default for a
# self-hosted box you rebuild deliberately (bootstrap/update build this image).
# If you instead want byte-for-byte reproducible, audit-stable builds, pin a
# digest here (FROM registry.fedoraproject.org/fedora-minimal@sha256:<digest>);
# each client bundle's own Containerfile can make that choice independently.

FROM registry.fedoraproject.org/fedora-minimal:latest

# Python stack via Fedora RPMs rather than pip. Fedora rebuilds the
# native packages against whatever python3 it ships, which sidesteps
# the "no wheel for this Python" trap, and shared libs dedupe cleanly
# across the stack.
#
# Using fedora-minimal (microdnf, ~80MB base) instead of full fedora
# (~190MB base) drops a layer of distro tooling we never use. Same
# RPM packages, same compatibility, just less cruft.
RUN microdnf install -y \
        --setopt=install_weak_deps=0 \
        --setopt=tsflags=nodocs \
        ImageMagick \
        bash \
        ca-certificates \
        coreutils \
        findutils \
        git \
        grep \
        jq \
        less \
        pandoc \
        unzip \
        python3 \
        python3-pip \
        python3-beautifulsoup4 \
        python3-ipykernel \
        python3-jupyter-client \
        python3-lxml \
        python3-matplotlib \
        python3-numpy \
        python3-openpyxl \
        python3-pandas \
        python3-pillow \
        python3-pyarrow \
        python3-pypdf \
        python3-pyyaml \
        python3-reportlab \
        python3-requests \
        python3-scikit-learn \
        python3-scipy \
        python3-seaborn \
        python3-tabulate \
        python3-xlsxwriter \
        ripgrep \
        sed \
        shadow-utils \
    && microdnf clean all \
    && rm -rf /var/cache/dnf /var/cache/yum /var/log/dnf* /var/log/yum* /usr/share/locale/* /usr/share/man

# ── CVE pins: pip-installed upgrades over the Fedora RPMs ──────────────────
# A deliberate, narrow deviation from the RPM-only rule above, for exactly the
# packages the CI Grype gate flags. Fedora's RPMs lag the upstream security
# releases for these (python3-pypdf ships 4.x against a 6.x upstream), and
# Grype matches the Python dist-info metadata by upstream version — so even a
# Fedora BACKPORT of a fix would keep flagging. The only clean signal is the
# upstream patched version. Each pin was reviewed against the GitHub Security
# Advisories it clears (minimum patched version in parentheses):
#   pypdf    6.14.2  (≥ 6.13.3 — GHSA-jm82-fx9c-mx94 and 27 older pypdf GHSAs)
#   tornado  6.5.7   (≥ 6.5.7  — GHSA-pw6j-qg29-8w7f, GHSA-3x9g-8vmp-wqvf,
#                     GHSA-mgf9-4vpg-hj56, GHSA-cx3h-4qpv-8hc9,
#                     GHSA-qjxf-f2mg-c6mc, GHSA-fqwm-6jpj-5wxc,
#                     GHSA-78cv-mqj4-43f7)
#   pip      26.1.2  (≥ 26.1   — GHSA-jp4c-xjxw-mgf9, GHSA-58qw-9mgm-455v)
#   idna     3.18    (≥ 3.15   — GHSA-65pc-fj4g-8rjx)
#   pygments 2.20.0  (≥ 2.20.0 — GHSA-5239-wwwm-4pmq)
#   soupsieve 2.8.4  (≥ 2.8.4  — GHSA-836r-79rf-4m37)
#
# The RPM copies are removed (rpm -e --nodeps) in the SAME layer: Grype scans
# the exported image tar, so a leftover old dist-info in
# /usr/lib/python3.*/site-packages would still flag even though the /usr/local
# copy shadows it on sys.path. Removing the RPM leaves exactly one unambiguous
# copy of each package. --nodeps is safe here because the pip-installed
# replacements satisfy the same imports the dependent RPMs (python3-ipykernel
# needs tornado, python3-requests needs idna, python3-beautifulsoup4 needs
# soupsieve, ...) resolve at runtime; the in-layer asserts below and the
# matplotlib warm run keep this honest.
# When bumping a pin, re-check the advisory list (gh api /advisories/GHSA-...).
#
# --ignore-installed is load-bearing: when Fedora's OWN rpm catches up to a
# pinned version (as python3-tornado did), plain pip sees the requirement
# already satisfied by the rpm copy in /usr/lib64 and installs NOTHING — then
# the rpm -e below deletes the only copy and the image stops building. The
# flag forces a fresh /usr/local install regardless of what the base image
# ships, keeping this layer immune to Fedora's package versions drifting
# under the pins.
RUN python3 -m pip install --no-cache-dir --ignore-installed \
        "pip==26.1.2" \
        "pypdf==6.14.2" \
        "tornado==6.5.7" \
        "idna==3.18" \
        "pygments==2.20.0" \
        "soupsieve==2.8.4" \
    && rpm -e --nodeps \
        python3-pip \
        python3-pypdf \
        python3-tornado \
        python3-idna \
        python3-pygments \
        python3-soupsieve \
    && python3 -c "import pip, pypdf, tornado, idna, pygments, soupsieve; \
        assert pip.__version__ == '26.1.2', pip.__version__; \
        assert pypdf.__version__ == '6.14.2', pypdf.__version__; \
        assert tornado.version == '6.5.7', tornado.version; \
        assert idna.__version__ == '3.18', idna.__version__; \
        assert pygments.__version__ == '2.20.0', pygments.__version__; \
        assert soupsieve.__version__ == '2.8.4', soupsieve.__version__" \
    && rm -rf /root/.cache/pip

# Pre-warm matplotlib's font cache so the first plot at runtime doesn't
# pay the multi-second TTF scan.
RUN python3 -c "import matplotlib.pyplot; matplotlib.pyplot.figure().savefig('/tmp/_warm.png'); import os; os.remove('/tmp/_warm.png')"

# Non-root user with a real $HOME. /home/sandbox is read-only at runtime;
# the directories that need to be writable (.ipython, .cache, /tmp) are
# expected to be tmpfs-mounted by the caller per the example above.
RUN useradd --create-home --uid 1000 --shell /bin/bash sandbox \
    && mkdir -p /home/sandbox/.cache /home/sandbox/.ipython /workspace /opt/bridge \
    && cp -r /root/.cache/matplotlib /home/sandbox/.cache/ 2>/dev/null || true \
    && chown -R sandbox:sandbox /home/sandbox /workspace /opt/bridge

USER sandbox
WORKDIR /workspace

# Default CMD keeps the namespace alive for callers that exec into the
# container repeatedly (e.g. running a long-lived bridge process via
# `podman exec -i`). One-shot callers can override.
CMD ["sleep", "infinity"]

# ── OPTIONAL: governed browser tool (#503) ──────────────────────────────────
# The in-sandbox browser tool (FLEET_BROWSER_ENABLED=true) needs Chromium +
# Playwright in this image. It is OFF by default and NOT installed here because
# a bundled Chromium adds image weight and its own CVE surface (the CI Grype
# gate fails on fixable CRITICALs). A deployment that wants the browser adds the
# layer below to its OWN client-config Containerfile and pins the version so a
# CVE is a single deliberate bump. Rootless-Podman notes: the tool launches
# Chromium with --no-sandbox --disable-dev-shm-usage (Chromium's own sandbox
# fights rootless user namespaces, and /dev/shm is small in the container), and
# the container's --init reaps the Chromium process tree. Run the browser under
# the ALLOWLISTED egress posture (FLEET_DEFAULT_NETWORK_MODE=allowlisted) so a
# prompt-injected page can't exfiltrate via navigate-to-arbitrary-host.
#
#   USER root
#   # Pin the Playwright version and let it pull the matching Chromium.
#   RUN pip install --no-cache-dir "playwright==1.49.1" \
#       && python3 -m playwright install --with-deps chromium
#   RUN chown -R sandbox:sandbox /home/sandbox/.cache 2>/dev/null || true
#   USER sandbox
